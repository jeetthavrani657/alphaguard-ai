reports/output/factor_ideas_latest.json
reports/output/midcap_survivorship_latest.json
reports/output/factor_ideas_run.log
reports/output/regen_*.log
reports/output/cost_sensitivity_latest.json
reports/output/cost_sensitivity_run.log
reports/output/overfit_checks_latest.json
reports/output/overfit_checks_run.log

# Intraday candles (data/intraday.py): research data cache, re-downloaded from Upstox on demand.
data/intraday/

# F&O end-of-day data (data/fo_bhavcopy.py): published exchange files, re-downloadable.
data/fo/

# Paper execution layer (execution/): its journal, account and tickets are local run state, not code.
execution/state/
reports/output/alerts_state.json
