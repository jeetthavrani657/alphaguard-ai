# Python
__pycache__/
*.pyc
.pytest_cache/

# Price-data cache: ~83 MB of per-symbol CSVs, re-downloaded from Yahoo by
# data/loader.py on demand. (Tests that read it skip themselves if absent.)
data/cache/

# Overwritten by every daily forward-test run -- full console output with the
# validator's long per-stock report. The HISTORY of the numbers is
# reports/output/forward_snapshots.csv, which IS tracked.
reports/output/forward_last_run.log

# Generated charts, regenerated by run_backtest.py / run_sweep.py
reports/output/*.png

# Stray one-off run logs
*_resolve_log.txt

# Web app result snapshots: ~70 MB of JSON, fully reproducible with
# `python -m webapp.backend.snapshot` (see README "Web app v2").
webapp/snapshots/

# Point-in-time news archive (research/news_logger.py): personal research data, not redistributed.
data/news/
reports/output/news_last_run.log

reports/output/forward_books_last_run.log
reports/output/forward_books_latest.json

# Verified fundamentals extracted from public filings (fundamentals/): personal research data.
data/fundamentals/
reports/output/fundamentals_last_run.log

# Upstox read-only data cache (data/upstox_client.py): the public instrument list, re-downloaded weekly.
data/upstox/
reports/output/live_quotes_latest.json
reports/output/health_latest.json
reports/output/health_last_run.log

# Multi-asset advisory (research/advisory.py): cached ETF prices and the generated file.
data/advisory/
reports/output/advisory_latest.json
reports/output/advisory_forward_latest.json
reports/output/advisory_forward_last_run.log
reports/output/multiasset_trend_latest.json
reports/output/multiasset_momentum_latest.json

# Personal work that is not part of the project's code: the college submission files and the editor's local config.
submission/
.claude/

